# TIP Tool - Docker settings. Copy to .env and fill in. Never commit .env.

# --- Site ---
SITE_NAME=TIP TOOL
# Public URL people use to reach the tool (https in production)
SITE_URL=http://localhost:8080
# Contact address shown on the site (optional)
ADMIN_EMAIL=
# Host port the app listens on
TIP_PORT=8080
# Image tag to run (latest, or a release such as 1.0.0)
TIP_VERSION=latest

# --- Database (the bundled MySQL container uses these too) ---
DB_HOST=db
DB_NAME=tiptool
DB_USER=tiptool
DB_PASS=change-me-to-a-long-random-password
DB_ROOT_PASS=change-me-to-another-long-random-password

# --- Encryption key for stored IMAP passwords (min 32 chars) ---
# Generate with: openssl rand -hex 32
# Keep it stable: changing it makes saved IMAP passwords unreadable.
CRON_SECRET_KEY=

# --- First admin account (created on first start only) ---
# Remove ADMIN_PASSWORD from this file after the first start.
ADMIN_USERNAME=admin
ADMIN_USER_EMAIL=
ADMIN_PASSWORD=

# --- Limits ---
EMAIL_EXPIRY_HOURS=24
RATE_LIMIT_HOURLY=20
RATE_LIMIT_DAILY=50

# --- Mail fetching (cron container) ---
FETCH_INTERVAL=60
CLEANUP_INTERVAL_SECONDS=3600

# --- Reverse proxy / CDN ---
# Comma-separated IPs or CIDRs of your reverse proxy, e.g. 172.16.0.0/12.
# Leave empty if the app is reached directly.
TRUSTED_PROXIES=
# true only when Cloudflare sits in front of the site
TRUST_CF_CONNECTING_IP=false
# Admin session IP pinning: subnet, strict, or off
SESSION_PIN_IP=subnet
